# Google AI Studio key (https://aistudio.google.com/apikey) - free tier works
GOOGLE_API_KEY=
# Exa search key (https://dashboard.exa.ai/api-keys)
EXA_API_KEY=

# Optional
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
DB_PATH=data/checkpoints.sqlite
MAX_REVISIONS=5
